# ---------------------------------------------------------------------------
# LemonAIde MCP — environment configuration
# Copy to .env (local dev) / set as Worker secrets (production).
# Marked [SECRET] values must never reach the browser, Vite bundles, logs, or MCP output.
# ---------------------------------------------------------------------------

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co            # public
SUPABASE_ANON_KEY=eyJ...                                 # public (RLS-protected)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                         # [SECRET] server-only
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1  # public

# --- Platform domain ---
APP_BASE_DOMAIN=apps.example.com                         # public; single primary domain
MCP_PUBLIC_URL=https://apps.example.com/mcp              # public; remote MCP endpoint

# --- Sessions ---
SESSION_SECRET=generate-with-openssl-rand-hex-32        # [SECRET]

# --- GitHub App (platform-managed) ---
GITHUB_APP_ID=123456                                     # [SECRET-ish] server-only
GITHUB_APP_CLIENT_ID=Iv1.abc                             # [SECRET] server-only
GITHUB_APP_CLIENT_SECRET=...                             # [SECRET] server-only
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----   # [SECRET] server-only (PEM, \n escaped)
GITHUB_APP_WEBHOOK_SECRET=...                            # [SECRET] server-only

# --- Build runner ---
# Bearer token the Worker uses to authenticate build-runner callbacks,
# and the GitHub Actions secret the runner uses to report status.
BUILD_RUNNER_TOKEN=generate-with-openssl-rand-hex-32     # [SECRET]

# --- Cloudflare (wrangler login handles auth; account id used by scripts) ---
CLOUDFLARE_ACCOUNT_ID=                                   # optional; wrangler picks up from login

# ── Dashboard (packages/dashboard/.env or root .env for vite dev) ──
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
